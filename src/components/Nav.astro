---
import { localizedHref } from "../lib/base";
import { LANGS, t, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  /** Current page path with no leading slash and no lang prefix, e.g. "search" or "" for home. */
  currentPath: string;
  /** Preserved across a language switch, e.g. "?manufacturer=nordic&mpn=..." */
  query?: string;
}

const { lang, currentPath, query = "" } = Astro.props;
const nav = t[lang].nav;

const links = [
  { href: localizedHref(lang, "search"), label: nav.search },
  { href: localizedHref(lang, "kicad-plugin"), label: nav.kicadPlugin },
  { href: localizedHref(lang, "contributing"), label: nav.contributing },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a class="nav-brand" href={localizedHref(lang, "")}>OpenParts</a>
    <nav>
      <ul class="nav-links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        {
          LANGS.map((l) => (
            <li>
              <a
                href={`${localizedHref(l, currentPath)}${query}`}
                aria-current={l === lang ? "page" : undefined}
                class={l === lang ? "lang-active" : ""}
              >
                {l.toUpperCase()}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .nav-brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-links a {
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--color-accent);
  }

  .lang-active {
    font-weight: 700;
    color: var(--color-accent) !important;
  }
</style>
