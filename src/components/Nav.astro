---
const links = [
  { href: "/search", label: "部品を探す" },
  { href: "/kicad-plugin", label: "KiCadプラグイン" },
  { href: "/contributing", label: "コントリビュート" },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a class="nav-brand" href="/">OpenParts</a>
    <nav>
      <ul class="nav-links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .nav-brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--color-accent);
  }
</style>
