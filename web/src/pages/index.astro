---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizedHref } from "../lib/base";
import { t } from "../lib/i18n";

const lang = "ja" as const;
const copy = t[lang].home;
---

<BaseLayout
  lang={lang}
  currentPath=""
  title="OpenParts"
  description={copy.metaDescription}
>
  <section class="hero">
    <h1>{copy.title}</h1>
    <p class="text-muted hero-lead">{copy.lead}</p>
    <div class="hero-actions">
      <a class="button button-primary" href={localizedHref(lang, "search")}>
        {copy.ctaSearch}
      </a>
      <a class="button" href={localizedHref(lang, "kicad-plugin")}>
        {copy.ctaKicad}
      </a>
    </div>
  </section>

  <section class="section features">
    {
      copy.features.map((feature) => (
        <div class="card">
          <h3>{feature.title}</h3>
          <p class="text-muted">{feature.body}</p>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    max-width: 640px;
  }

  .hero-lead {
    font-size: 1.05rem;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
  }
</style>
