---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t } from "../../lib/i18n";

const lang = "en" as const;
const copy = t[lang].kicadPlugin;
---

<BaseLayout
  lang={lang}
  currentPath="kicad-plugin"
  title={copy.title}
  description={copy.metaDescription}
>
  <h1>{copy.title}</h1>
  <p class="text-muted">{copy.intro}</p>

  <section class="section">
    <h2>{copy.quickInstall}</h2>

    <h3>Linux</h3>
    <pre><code>curl -fsSL https://raw.githubusercontent.com/openparts-org/openparts-kicad-plugin/main/install.sh | bash</code></pre>

    <h3>Windows (PowerShell)</h3>
    <pre><code>irm https://raw.githubusercontent.com/openparts-org/openparts-kicad-plugin/main/install.ps1 | iex</code></pre>

    <p class="text-muted">{copy.autoDetectNote}</p>
    <p class="text-muted">{copy.restartNote}</p>
  </section>

  <section class="section">
    <h2>{copy.goodToKnow}</h2>
    <p class="text-muted">{copy.sessionNote}</p>
  </section>
</BaseLayout>
