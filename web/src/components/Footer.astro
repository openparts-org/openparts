---
import { t, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const repos = [
  { href: "https://github.com/openparts-org/openparts", label: "openparts" },
  {
    href: "https://github.com/openparts-org/openparts-data",
    label: "openparts-data",
  },
  {
    href: "https://github.com/openparts-org/openparts/tree/main/server",
    label: "server",
  },
  {
    href: "https://github.com/openparts-org/openparts/tree/main/kicad-plugin",
    label: "kicad-plugin",
  },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <span class="text-muted">{t[lang].footer.openSource}</span>
    <ul class="footer-links">
      {
        repos.map((repo) => (
          <li>
            <a href={repo.href} target="_blank" rel="noopener noreferrer">
              {repo.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-5);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }
</style>
