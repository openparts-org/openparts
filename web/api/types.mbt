  existence : Existence
  id : String
  kind : Kind
  lifecycle : Lifecycle
  manufacturer : String
  mpn : String
  package_ : String
  parameters : Map[String, Array[ParameterValue]]?
  provenance : Map[String, Array[ProvenanceEntry]]
  review : DocumentReview?
  schema_version : String
  sources : Array[String]
}

///|
pub impl @json.FromJson for Part with fn from_json(json, path) {
  guard json is Object(obj) else {
    raise @json.JsonDecodeError((path, "expected a Part object"))
  }
  {
    assembly: opt_field(obj, "assembly", path),
    device: field(obj, "device", path),
    existence: field(obj, "existence", path),
    id: field(obj, "id", path),
    kind: field(obj, "kind", path),
    lifecycle: field(obj, "lifecycle", path),
    manufacturer: field(obj, "manufacturer", path),
    mpn: field(obj, "mpn", path),
    package_: field(obj, "package", path),
    parameters: opt_field(obj, "parameters", path),
    provenance: field_or(obj, "provenance", path, {}),
    review: opt_field(obj, "review", path),
    schema_version: field(obj, "schema_version", path),
    sources: field_or(obj, "sources", path, []),
  }
}

