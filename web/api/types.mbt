///|
#derive(Eq)
pub(all) struct PackageGeometrySpec {
  generator : String?
  type_ : GeometryType
}

///|
pub impl @json.FromJson for PackageGeometrySpec with fn from_json(json, path) {
  guard json is Object(obj) else {
    raise @json.JsonDecodeError((path, "expected a PackageGeometrySpec object"))
  }
  {
    generator: opt_field(obj, "generator", path),
    type_: field(obj, "type", path),
  }
}

///|
/// One pad of an explicit land pattern (`Package::pads`), in mm, top
/// view, X right and Y up (the family documents the origin). `width` is
/// the pad along X, `length` along Y. A plated hole has a `drill`
/// diameter; a slotted hole also a `drill_length` (the slot's overall
/// length, along the pad's longer side).
#derive(Eq)
pub(all) struct PackagePad {
  drill : Double?
  drill_length : Double?
  length : Double
  number : String
  plated : Bool?
  width : Double
  x : Double
  y : Double
}

///|
pub impl @json.FromJson for PackagePad with fn from_json(json, path) {
  guard json is Object(obj) else {
    raise @json.JsonDecodeError((path, "expected a PackagePad object"))
  }
  {
    drill: opt_field(obj, "drill", path),
    drill_length: opt_field(obj, "drill_length", path),
    length: field(obj, "length", path),
    number: field(obj, "number", path),
    plated: opt_field(obj, "plated", path),
    width: field(obj, "width", path),
    x: field(obj, "x", path),
    y: field(obj, "y", path),
  }
}

///|
/// The wide tab of a power package (SOT-223, TO-252/DPAK) -- soldered
/// to the board and electrically one of the device's terminals. How the
/// datasheet numbers it varies by vendor ("4", "TAB", or simply tied to
/// pin 2), which is why it is recorded here rather than derived; packages
/// whose outline is identical but whose tab is numbered differently are
/// separate Packages (as KiCad's `SOT-223-3_TabPin2` / `_TabPin4`).
#derive(Eq)
pub(all) struct PackageTab {
  number : String
  trimmed_leads : Array[String]?
}

///|
pub impl @json.FromJson for PackageTab with fn from_json(json, path) {
  guard json is Object(obj) else {
    raise @json.JsonDecodeError((path, "expected a PackageTab object"))
  }
  {
    number: field(obj, "number", path),
    trimmed_leads: opt_field(obj, "trimmed_leads", path),
  }
}

///|
/// One electrical-parameter facet: present only when some part under
/// the other filters states the key (or the key is filtered on).
#derive(Eq)
pub(all) struct ParameterFacet {
  key : String
  kind : ParameterKind
  max : Double?
  max_label : String?
  min : Double?
  min_label : String?
  unit : String
  values : Array[FacetValue]
}

///|
pub impl @json.FromJson for ParameterFacet with fn from_json(json, path) {
  guard json is Object(obj) else {
    raise @json.JsonDecodeError((path, "expected a ParameterFacet object"))
  }
  {
    key: field(obj, "key", path),
    kind: field(obj, "kind", path),
    max: opt_field(obj, "max", path),
    max_label: opt_field(obj, "max_label", path),
    min: opt_field(obj, "min", path),
    min_label: opt_field(obj, "min_label", path),
    unit: field(obj, "unit", path),
    values: field(obj, "values", path),
  }
}

///|
#derive(Eq, Debug)
pub(all) enum ParameterKind {
  Numeric
  Enumerated
}

///|
/// The wire (JSON) string.
pub fn ParameterKind::wire(self : ParameterKind) -> String {
  match self {
    Numeric => "numeric"
    Enumerated => "enumerated"
  }
}

///|
/// Every value, in declaration order.
pub fn ParameterKind::all() -> Array[ParameterKind] {
  [Numeric, Enumerated]
}

///|
pub impl @json.FromJson for ParameterKind with fn from_json(json, path) {
  match json {
    String("numeric") => Numeric
    String("enumerated") => Enumerated
    _ => raise @json.JsonDecodeError((path, "expected a ParameterKind"))
  }
}

///|
/// One parameter value as the data states it. A numeric key uses
/// `nominal`/`min`/`max` + `unit` (like a [`crate::Dimension`]; none of
/// the three is invented when the source doesn't state it); an
/// enumerated key uses `value`. Which shape a key takes is fixed by the
/// vocabulary; the validator rejects the other one.
#derive(Eq)
pub(all) struct ParameterValue {
  max : Double?
  min : Double?
  nominal : Double?
  unit : String?
  value : String?
}

///|
pub impl @json.FromJson for ParameterValue with fn from_json(json, path) {
  guard json is Object(obj) else {
    raise @json.JsonDecodeError((path, "expected a ParameterValue object"))
  }
  {
    max: opt_field(obj, "max", path),
    min: opt_field(obj, "min", path),
    nominal: opt_field(obj, "nominal", path),
    unit: opt_field(obj, "unit", path),
    value: opt_field(obj, "value", path),
  }
}

///|
/// Canonical Data Specification section 11. Never duplicates Device
/// pinout or Package dimensions — only references them.
#derive(Eq)
pub(all) struct Part {
  device : String
  existence : Existence
  id : String
  kind : Kind
  lifecycle : Lifecycle
  manufacturer : String
  mpn : String
  package_ : String
  parameters : Map[String, ParameterValue]?
  provenance : Map[String, Array[ProvenanceEntry]]
  schema_version : String
  sources : Array[String]
}

///|
pub impl @json.FromJson for Part with fn from_json(json, path) {
  guard json is Object(obj) else {
    raise @json.JsonDecodeError((path, "expected a Part object"))
  }
  {
    device: field(obj, "device", path),
    existence: field(obj, "existence", path),
    id: field(obj, "id", path),
    kind: field(obj, "kind", path),
    lifecycle: field(obj, "lifecycle", path),
    manufacturer: field(obj, "manufacturer", path),
    mpn: field(obj, "mpn", path),
    package_: field(obj, "package", path),
    parameters: opt_field(obj, "parameters", path),
    provenance: field_or(obj, "provenance", path, {}),
    schema_version: field(obj, "schema_version", path),
    sources: field_or(obj, "sources", path, []),
  }
}

