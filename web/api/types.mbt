///|
/// Canonical Data Specification section 20.
///
/// `body_width` runs along X and `body_length` along Y of the package's
/// own frame (the frame the Geometry Generator lays leads out in), and
/// every `overall_*` span below is measured along the same axis as the
/// body dimension of the same name. The lead dimensions are the
/// datasheet's package-outline symbols (JEDEC naming in brackets); a
/// field the datasheet doesn't state stays `None` -- the generator then
/// falls back to its own documented family default, which is never
/// written back here (section 7).
#derive(Eq)
pub(all) struct PackageDimensions {
  actuator_diameter : Dimension?
  actuator_elevation : Dimension?
  actuator_length : Dimension?
  actuator_thickness : Dimension?
  actuator_width : Dimension?
  aux_pad_length : Dimension?
  aux_pad_width : Dimension?
  aux_row_x : Dimension?
  aux_row_y : Dimension?
  body_height : Dimension?
  body_length : Dimension
  body_offset : Dimension?
  body_width : Dimension
  can_diameter : Dimension?
  exposed_pad : ExposedPadDimensions?
  ground_terminal_offset : Dimension?
  ground_terminal_width : Dimension?
  hole_diameter : Dimension?
  lead_inset : Dimension?
  lead_length : Dimension?
  lead_thickness : Dimension?
  lead_width : Dimension?
  mating_diameter : Dimension?
  mating_length : Dimension?
  mounting_hole_diameter : Dimension?
  mounting_hole_inset : Dimension?
  mounting_hole_spacing : Dimension?
  overall_height : Dimension?
  overall_length : Dimension?
  overall_width : Dimension?
  pad_diameter : Dimension?
  pin_diameter : Dimension?
  row_spacing : Dimension?
  standoff : Dimension?
  tab_length : Dimension?
  tab_width : Dimension?
  tail_length : Dimension?
}

///|
pub impl @json.FromJson for PackageDimensions with fn from_json(json, path) {
  guard json is Object(obj) else {
    raise @json.JsonDecodeError((path, "expected a PackageDimensions object"))
