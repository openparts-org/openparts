    actuator_elevation: opt_field(obj, "actuator_elevation", path),
    actuator_length: opt_field(obj, "actuator_length", path),
    actuator_thickness: opt_field(obj, "actuator_thickness", path),
    actuator_width: opt_field(obj, "actuator_width", path),
    aux_pad_length: opt_field(obj, "aux_pad_length", path),
    aux_pad_width: opt_field(obj, "aux_pad_width", path),
    aux_row_x: opt_field(obj, "aux_row_x", path),
    aux_row_y: opt_field(obj, "aux_row_y", path),
    body_height: opt_field(obj, "body_height", path),
    body_length: field(obj, "body_length", path),
    body_offset: opt_field(obj, "body_offset", path),
    body_width: field(obj, "body_width", path),
    can_diameter: opt_field(obj, "can_diameter", path),
    exposed_pad: opt_field(obj, "exposed_pad", path),
    ground_terminal_offset: opt_field(obj, "ground_terminal_offset", path),
    ground_terminal_width: opt_field(obj, "ground_terminal_width", path),
    hole_diameter: opt_field(obj, "hole_diameter", path),
    lead_inset: opt_field(obj, "lead_inset", path),
    lead_length: opt_field(obj, "lead_length", path),
    lead_thickness: opt_field(obj, "lead_thickness", path),
    lead_width: opt_field(obj, "lead_width", path),
    mating_diameter: opt_field(obj, "mating_diameter", path),
    mating_length: opt_field(obj, "mating_length", path),
    mounting_hole_diameter: opt_field(obj, "mounting_hole_diameter", path),
    mounting_hole_inset: opt_field(obj, "mounting_hole_inset", path),
    mounting_hole_spacing: opt_field(obj, "mounting_hole_spacing", path),
    overall_height: opt_field(obj, "overall_height", path),
    overall_length: opt_field(obj, "overall_length", path),
    overall_width: opt_field(obj, "overall_width", path),
    pad_diameter: opt_field(obj, "pad_diameter", path),
    pin_diameter: opt_field(obj, "pin_diameter", path),
    row_spacing: opt_field(obj, "row_spacing", path),
    standoff: opt_field(obj, "standoff", path),
    tab_length: opt_field(obj, "tab_length", path),
    tab_width: opt_field(obj, "tab_width", path),
    tail_length: opt_field(obj, "tail_length", path),
  }
}

