///|
/// `Package::keepouts`: one keep-out area as the source states it --
/// located (`rect`), or only sized (`size`, the two lengths in the
/// source's order, orientation not given) and placed against a
/// package `side`. Exactly one of `rect` / `size`.
#derive(Eq)
pub(all) struct PackageKeepout {
  purpose : KeepoutPurpose
  rect : PackageRect?
  restricts : Array[KeepoutRestriction]
  side : PackageSide?
  size : Array[Double]?
}

///|
pub impl @json.FromJson for PackageKeepout with fn from_json(json, path) {
  guard json is Object(obj) else {
    raise @json.JsonDecodeError((path, "expected a PackageKeepout object"))
  }
  {
    purpose: field(obj, "purpose", path),
    rect: opt_field(obj, "rect", path),
    restricts: field(obj, "restricts", path),
    side: opt_field(obj, "side", path),
    size: opt_field(obj, "size", path),
  }
}

///|
/// One pad of an explicit land pattern (`Package::pads`), in mm, top
/// view, X right and Y up (the family documents the origin). `width` is
/// the pad along X, `length` along Y. A plated hole has a `drill`
/// diameter; a slotted hole also a `drill_length` (the slot's overall
/// length, along the pad's longer side). A plated hole whose source draws
/// no land around it leaves `width`/`length` out (0): the connector
/// families then draw a generator-default annular ring, and a slot needs
/// `slot_axis` (Canonical Data Specification 20.6).
///
/// A land is a rectangle unless `shape` says otherwise (section 20.7):
/// `circle` (`width` = `length`, the diameter), `chamfered` (corners cut
/// by `chamfer`, the corners listed in `corners`, all four when empty) or
/// `polygon` (`points` relative to `x`/`y`; `width`/`length` left out) or
/// `annular` (a ring: `width` = `length` the outer diameter,
/// `inner_diameter` the hole; `x`/`y` its centre). A `cutout` circle
/// clears copper from a rectangular land (an RF connector's ground pads
/// notched around its centre contact).
#derive(Eq)
pub(all) struct PackagePad {
  chamfer : Double?
  corners : Array[PadCorner]?
  cutout : PadCutout?
  drill : Double?
  drill_length : Double?
  inner_diameter : Double?
  length : Double?
  number : String
  plated : Bool?
  points : Array[Array[Double]]?
  shape : LandShape?
  side : PadSide?
  slot_axis : SlotAxis?
  width : Double?
  x : Double
  y : Double
}

///|
pub impl @json.FromJson for PackagePad with fn from_json(json, path) {
  guard json is Object(obj) else {
    raise @json.JsonDecodeError((path, "expected a PackagePad object"))
  }
  {
    chamfer: opt_field(obj, "chamfer", path),
    corners: opt_field(obj, "corners", path),
    cutout: opt_field(obj, "cutout", path),
    drill: opt_field(obj, "drill", path),
    drill_length: opt_field(obj, "drill_length", path),
    inner_diameter: opt_field(obj, "inner_diameter", path),
    length: opt_field(obj, "length", path),
    number: field(obj, "number", path),
    plated: opt_field(obj, "plated", path),
    points: opt_field(obj, "points", path),
    shape: opt_field(obj, "shape", path),
    side: opt_field(obj, "side", path),
    slot_axis: opt_field(obj, "slot_axis", path),
    width: opt_field(obj, "width", path),
    x: field(obj, "x", path),
    y: field(obj, "y", path),
  }
}

///|
/// `Package::pad_grids` (`module`): a rectangular grid of equal pads,
/// such as a module's segmented ground pad. Section 20.4.
#derive(Eq)
pub(all) struct PackagePadGrid {
  columns : Int32
  numbers : Array[String]
  pad : Array[Double]
  pitch : Array[Double]
  rows : Int32
  x : Double
  y : Double
}

///|
